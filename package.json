{
  "name": "jira-time-log-app",
  "version": "1.0.0",
  "description": "Jira Time Log Dashboard - Unified Backend and Frontend",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/bin/www",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/bin/www",
    "client": "cd client && npm start",
    "build": "concurrently \"npm run server\" \"npm run client\"",
    "install-client": "cd client && npm install",
    "install-server": "npm install",
    "install-all": "npm run install-server && npm run install-client",
    "heroku-postbuild": "npm run install-client && npm run build"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "express": "~4.16.1",
    "jira-client": "^8.2.2",
    "morgan": "~1.9.1",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "keywords": [
    "jira",
    "time-log",
    "dashboard",
    "react",
    "express"
  ],
  "author": "",
  "license": "MIT"
} 